# Copy this file to .env and fill in real values.
# Never commit the real .env file to git or send it to anyone.

# Port the API server listens on
PORT=4000

# Where the frontend is served from. The browser will only send the
# login cookie back to the API if this matches exactly. If server.js
# is serving the frontend itself (the default setup), this can stay
# as your local/deployed app URL — same origin either way.
CLIENT_ORIGIN=http://localhost:4000

# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Connection string for your MongoDB server. Include the database
# name at the end of the path (here: "docket"). For a local MongoDB
# install, mongodb://localhost:27017/docket is correct as-is.
MONGODB_URI=mongodb://localhost:27017/docket

# From Google Cloud Console -> APIs & Services -> Credentials
# (OAuth client ID, Web application). Leave the placeholder in place
# to keep Google sign-in disabled until you're ready.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# From Apple Developer -> Certificates, Identifiers & Profiles ->
# Identifiers -> Services IDs (with "Sign in with Apple" enabled).
APPLE_CLIENT_ID=your_apple_services_id

# Set to "production" once this is deployed for real behind HTTPS.
# This switches login cookies to Secure + SameSite=None, which
# browsers require for cross-site cookies over HTTPS.
NODE_ENV=development
